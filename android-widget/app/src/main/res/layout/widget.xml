<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de Rumbo (estilo Duolingo):
  - Fondo de color según cómo vas (verde, azul, naranja o rojo).
  - Mascota animada: un ViewFlipper pasa sus cuadros (parpadea, salta y saluda).
  - Tarjetas que rotan solas cada 6 s: estado, entregas, recordatorios, frase del día y tu semana.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wbg_tranqui">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <!-- Mascota + racha -->
        <FrameLayout
            android:layout_width="86dp"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/halo" />

            <ViewFlipper
                android:id="@+id/mascot"
                android:layout_width="72dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:autoStart="true"
                android:flipInterval="550">
                <ImageView android:id="@+id/f1" style="@style/Frame" android:src="@drawable/mascot_tranqui" />
                <ImageView android:id="@+id/f2" style="@style/Frame" android:src="@drawable/mascot_tranqui_up" />
                <ImageView android:id="@+id/f3" style="@style/Frame" android:src="@drawable/mascot_tranqui" />
                <ImageView android:id="@+id/f4" style="@style/Frame" android:src="@drawable/mascot_tranqui" />
                <ImageView android:id="@+id/f5" style="@style/Frame" android:src="@drawable/mascot_tranqui_blink" />
                <ImageView android:id="@+id/f6" style="@style/Frame" android:src="@drawable/mascot_tranqui" />
                <ImageView android:id="@+id/f7" style="@style/Frame" android:src="@drawable/mascot_tranqui_wave" />
                <ImageView android:id="@+id/f8" style="@style/Frame" android:src="@drawable/mascot_tranqui_wave2" />
                <ImageView android:id="@+id/f9" style="@style/Frame" android:src="@drawable/mascot_tranqui_wave" />
                <ImageView android:id="@+id/f10" style="@style/Frame" android:src="@drawable/mascot_tranqui" />
            </ViewFlipper>

            <TextView
                android:id="@+id/streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/pill_white"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="🔥 0"
                android:textColor="#F97316"
                android:textSize="11sp" />
        </FrameLayout>

        <!-- Tarjetas que rotan -->
        <ViewFlipper
            android:id="@+id/cards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:autoStart="true"
            android:flipInterval="6000"
            android:inAnimation="@anim/slide_in"
            android:outAnimation="@anim/slide_out">

            <!-- 1. Cómo vas -->
            <LinearLayout style="@style/Card">
                <TextView android:id="@+id/kicker1" style="@style/Kicker" android:text="TU DÍA EN RUMBO" />
                <TextView
                    android:id="@+id/headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="2"
                    android:text="Conecta tu Rumbo"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp" />
                <TextView
                    android:id="@+id/sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Abre la app Rumbo para enlazarlo"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 2. Próximas entregas -->
            <LinearLayout style="@style/Card">
                <TextView style="@style/Kicker" android:text="📚 PRÓXIMAS ENTREGAS" />
                <TextView android:id="@+id/t1" style="@style/Row" android:text="Nada pendiente 🎉" android:visibility="visible" />
                <TextView android:id="@+id/t2" style="@style/Row" />
                <TextView android:id="@+id/t3" style="@style/Row" />
            </LinearLayout>

            <!-- 3. Recordatorios -->
            <LinearLayout style="@style/Card">
                <TextView style="@style/Kicker" android:text="⏰ RECORDATORIOS" />
                <TextView android:id="@+id/r1" style="@style/Row" android:text="Sin recordatorios. Pídele uno al asistente." android:visibility="visible" />
                <TextView android:id="@+id/r2" style="@style/Row" />
                <TextView android:id="@+id/r3" style="@style/Row" />
            </LinearLayout>

            <!-- 4. Frase del día -->
            <LinearLayout style="@style/Card">
                <TextView style="@style/Kicker" android:text="💬 FRASE DEL DÍA" />
                <TextView
                    android:id="@+id/phrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingMultiplier="1.1"
                    android:maxLines="3"
                    android:text="Un chin cada día y llegas lejos"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- 5. Tu semana -->
            <LinearLayout style="@style/Card">
                <TextView style="@style/Kicker" android:text="📈 TU SEMANA" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/s1" style="@style/Stat" android:text="0\nracha" />
                    <TextView android:id="@+id/s2" style="@style/Stat" android:layout_marginStart="6dp" android:text="0\nhechas" />
                    <TextView android:id="@+id/s3" style="@style/Stat" android:layout_marginStart="6dp" android:text="0\npendientes" />
                </LinearLayout>
            </LinearLayout>
        </ViewFlipper>
    </LinearLayout>

    <ImageView
        android:id="@+id/refresh"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:alpha="0.85"
        android:contentDescription="Actualizar"
        android:padding="8dp"
        android:src="@android:drawable/ic_popup_sync"
        android:tint="#FFFFFF" />

    <TextView
        android:id="@+id/update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/pill_white"
        android:elevation="2dp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="⬆️ Nueva versión · toca para actualizar"
        android:textColor="#1D4FD8"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:alpha="0.75"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="9sp" />
</FrameLayout>
