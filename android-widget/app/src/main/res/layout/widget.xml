<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Hoy» (4×2): todo el dibujo viene de Art.java; encima solo el aviso de versión nueva y un área para actualizar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Rumbo"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/refresh"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:contentDescription="Actualizar"
        android:src="@android:color/transparent" />

    <TextView
        android:id="@+id/update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:background="@drawable/btn_green"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="⬆ Nueva versión"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
