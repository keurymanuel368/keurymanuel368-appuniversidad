<?xml version="1.0" encoding="utf-8"?>
<!-- Rumbo · widget (el fondo cambia de color según cómo va tu día) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_g_blue"
    android:clipChildren="true">
    <ImageView android:layout_width="170dp" android:layout_height="170dp" android:layout_gravity="bottom|end" android:layout_marginEnd="-46dp" android:layout_marginBottom="-52dp" android:alpha="0.10" android:src="@drawable/ic_watermark" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/w_mark" android:padding="3dp" android:src="@drawable/ic_compass" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:text="Rumbo" android:layout_marginStart="6dp" android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="bottom" android:orientation="horizontal">
            <TextView android:id="@+id/bigNum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="44sp" android:textColor="#FFFFFFFF" android:includeFontPadding="false" android:text="0" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:letterSpacing="-0.04"/>
            <TextView android:id="@+id/bigUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#D9FFFFFF" android:includeFontPadding="false" android:text="pendientes" android:layout_marginStart="5dp" android:layout_marginBottom="6dp" android:maxLines="2" android:lineSpacingMultiplier="0.95"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp" />
        <TextView android:id="@+id/title1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:lineSpacingMultiplier="0.95" android:text="Toca para conectar" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <Chronometer android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/w_pill" android:paddingStart="9dp" android:paddingTop="4dp" android:paddingEnd="9dp" android:paddingBottom="4dp" android:textSize="12sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:textColor="#FF2F6BFF" android:visibility="gone" />
            <TextView android:id="@+id/when1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/w_pill_glass" android:paddingStart="9dp" android:paddingTop="4dp" android:paddingEnd="9dp" android:paddingBottom="4dp" android:textSize="11.5sp" android:textColor="#FFFFFFFF" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
