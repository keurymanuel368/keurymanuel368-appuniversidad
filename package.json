{
  "name": "rumbo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "dev": "npm run build && wrangler dev",
    "db:local": "wrangler d1 migrations apply rumbo-db --local",
    "db:remote": "wrangler d1 migrations apply rumbo-db --remote",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npm test && npm run build && npm run smoke && wrangler deploy && node scripts/announce.mjs && node scripts/backup-code.mjs",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "backup:db": "node scripts/backup-db.mjs",
    "visual": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.145.0"
  }
}
