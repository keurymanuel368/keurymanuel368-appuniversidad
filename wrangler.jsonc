{
  // Rumbo: un solo Worker sirve la app (PWA) y la API. Todo en el plan gratis de Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rumbo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rumbo-db",
      // Pega aquí el id que te da: npx wrangler d1 create rumbo-db
      "database_id": "4ebcd232-495b-4893-8bd6-0fe9a3f516dc",
      "migrations_dir": "migrations"
    }
  ],
  // Copias de seguridad semanales de tus datos (KV, plan gratis). Se ven y descargan en Ajustes.
  "kv_namespaces": [{ "binding": "BACKUPS", "id": "ae58212e218447b9bee6016159d31556" }],
  // Workers AI (plan gratis): transcribe las notas de voz que le mandas al asistente por WhatsApp.
  "ai": { "binding": "AI" },
  // Pantallas en vivo: un Durable Object por usuario mantiene los WebSockets (src/worker/live.ts). Plan gratis (SQLite).
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "RumboLive" }] },
  "migrations": [{ "tag": "v1-live", "new_sqlite_classes": ["RumboLive"] }],
  // Un solo cron cada 10 minutos: sincroniza el EVA, envía el resumen diario y los recordatorios.
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "TZ_OFFSET_HOURS": "-4",
    "MOODLE_URL": "https://eva.uapa.edu.do",
    // Dirección pública de la app: va en los enlaces de los avisos por WhatsApp.
    "APP_URL": "https://rumbo.gestori.workers.dev"
  }
  // Secretos (NO van aquí). Créalos con: npx wrangler secret put NOMBRE
  // APP_PASSWORD, SESSION_SECRET, MOODLE_TOKEN,
  // WA_PHONE_NUMBER_ID, WA_TOKEN, WA_VERIFY_TOKEN, WA_APP_SECRET, WA_MY_NUMBER,
  // CALLMEBOT_APIKEY
  ,
  // Entorno de PRUEBAS: copia aparte (su propia base de datos), se despliega desde la rama "dev". No toca tus datos reales.
  "env": {
    "pruebas": {
      "name": "rumbo-pruebas",
      "d1_databases": [{ "binding": "DB", "database_name": "rumbo-pruebas", "database_id": "7f329197-d8bb-4fa1-954b-f7fa7b6d802c", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "BACKUPS", "id": "a5cea9264557412086dbc93f1eb5594c" }],
      "ai": { "binding": "AI" },
      "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "RumboLive" }] },
      "migrations": [{ "tag": "v1-live", "new_sqlite_classes": ["RumboLive"] }],
      "triggers": { "crons": [] },
      "vars": { "TZ_OFFSET_HOURS": "-4", "MOODLE_URL": "https://eva.uapa.edu.do", "APP_URL": "https://rumbo-pruebas.gestori.workers.dev" }
    }
  }
}
